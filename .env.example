# ---------- Payload ----------
# 生产环境必须改为随机字符串（至少 16 字符）
PAYLOAD_SECRET=change-me-to-a-random-string-at-least-16-chars

# ---------- 数据库 ----------
# 默认：本地 SQLite 文件（零依赖）
DATABASE_URL=file:./payload.db
# Docker 自托管示例：
# DATABASE_URL=file:/app/data/payload.db
#
# 部署到 Vercel 等无持久文件系统的平台时，改用 Turso 远程 SQLite：
#   1. 注册 https://turso.tech 创建免费数据库
#   2. DATABASE_URL=libsql://<数据库名>-<组织名>.turso.io
DATABASE_AUTH_TOKEN=

# ---------- 站点 ----------
# 站点公开 URL（用于 SEO 元数据 / sitemap / RSS），部署时改为你的域名
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
